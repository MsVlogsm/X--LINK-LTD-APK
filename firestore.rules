rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidBillingRecord(data) {
      return (!('id' in data) || data.id is string) &&
             data.customerId is string &&
             data.amount is number &&
             data.amount >= 0 &&
             data.billingMonth is string &&
             data.dueDate is string &&
             data.isPaid is bool;
    }

    match /billing_records/{recordId} {
      // Allow read and write for authenticated users
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidBillingRecord(request.resource.data);
      allow update: if isSignedIn() && isValidBillingRecord(request.resource.data);
      allow delete: if isSignedIn();
    }
  }
}
